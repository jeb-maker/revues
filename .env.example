# Revues — variables d'environnement
# Dev : copier vers .env (ne pas committer)
# Prod Docker : bash deploy/generate-env.sh (génère secrets + HOST_PORT)

# Serveur
REVUES_ADDR=:8080
REVUES_BASE_URL=http://localhost:8080
# Prod exemple : https://revues.betafly.ovh

# SPA SvelteKit (optionnel) — défaut : frontend/build s'il existe
# REVUES_SPA_DIR=frontend/build

# Port hôte Docker (compose bind 127.0.0.1 → conteneur :8080)
REVUES_HOST_PORT=8088

# Base de données
REVUES_DATABASE_PATH=data/revues.db
# Taille du pool SQLite (WAL + busy_timeout) — défaut 10
# REVUES_DB_MAX_OPEN_CONNS=10

# Sécurité (en production : secret unique ≥32 caractères — le défaut est refusé au démarrage)
REVUES_SESSION_SECRET=change-me-32-random-bytes-minimum
REVUES_ENCRYPTION_KEY=change-me-32-bytes-base64-for-aes-256-gcm

# GitHub OAuth (callback : {BASE_URL}/auth/github/callback)
REVUES_GITHUB_CLIENT_ID=
REVUES_GITHUB_CLIENT_SECRET=

# Atlassian OAuth 3LO — Jira Cloud create/link en tant que l'utilisateur
# (callback : {BASE_URL}/auth/atlassian/callback ; scopes read/write jira + offline_access)
REVUES_ATLASSIAN_CLIENT_ID=
REVUES_ATLASSIAN_CLIENT_SECRET=

# Bootstrap admin (premier démarrage)
REVUES_BOOTSTRAP_ADMIN_EMAIL=
# Si true : refuse register/OAuth sauf membre org / invitation pending / bootstrap (message générique anti-énumération)
REVUES_LOGIN_REQUIRE_WHITELIST=

# Pièces jointes
REVUES_ATTACHMENTS_DIR=data/attachments

# Environnement (production : fail-fast secrets + Secure cookies ; https BaseURL active aussi Secure)
REVUES_ENV=development

# Auth démo locale (jamais en production) — bypass OAuth GitHub
# Uniquement si la requête vient de 127.0.0.1 / localhost (peer + Host).
# REVUES_DEV_AUTH=1
# REVUES_DEV_AUTH_EMAIL=admin@example.com
